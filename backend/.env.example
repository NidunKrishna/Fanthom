APP_ENV=development
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD=root
# Optional locally. If empty, a random key is generated at startup.
# Required in production: generate with python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Production requires an Argon2 hash, instead of the demo password.
ADMIN_PASSWORD_HASH=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required graph catalog and user preference storage. No CSV fallback.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
CATALOG_POLL_SECONDS=10
