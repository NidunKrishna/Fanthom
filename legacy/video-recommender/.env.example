# Google OAuth Credentials (get these from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# OAuth redirect URI must match what's configured in Google Cloud Console
# e.g. http://localhost:5000/auth/callback
